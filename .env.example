# Banco de dados (compativel com o docker-compose.yml deste repositorio)
DATABASE_URL="postgresql://lanchonete:lanchonete@localhost:5432/lanchonete?schema=public"

# Aplicacao
PORT=3000
NODE_ENV=development

# Autenticacao JWT
JWT_SECRET="troque-este-valor-em-producao"
JWT_EXPIRES_IN="1h"

# Hash de senha (bcrypt)
BCRYPT_SALT_ROUNDS=10

# Gateway de pagamento simulado (mock)
PAGAMENTO_MOCK_URL="http://localhost:3000/pagamentos/mock"
