generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  GERENTE
  ATENDENTE
  COZINHA
  CLIENTE
}

enum OrderChannel {
  APP
  TOTEM
  BALCAO
  PICKUP
  WEB
}

enum OrderStatus {
  AGUARDANDO_PAGAMENTO
  PAGO
  EM_PREPARO
  PRONTO
  CONCLUIDO
  CANCELADO
}

enum PaymentStatus {
  PENDENTE
  APROVADO
  RECUSADO
  ESTORNADO
}

enum PaymentMethod {
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  DINHEIRO
  MOCK
}

enum InventoryMovementType {
  ENTRADA
  SAIDA
  AJUSTE
}

model User {
  id               Int       @id @default(autoincrement())
  name             String
  email            String    @unique
  passwordHash     String
  role             UserRole  @default(CLIENTE)
  active           Boolean   @default(true)
  termsAcceptedAt  DateTime?
  loyaltyConsentAt DateTime? // programa de fidelidade
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  branchId           Int?
  branch             Branch?             @relation(fields: [branchId], references: [id])
  inventoryMovements InventoryMovement[]
}

model Branch {
  id             Int      @id @default(autoincrement())
  code           String   @unique // codigo da loja (ex.: "SP-001")
  name           String
  isHeadquarters Boolean  @default(false) // matriz da rede
  city           String
  state          String   @db.Char(2)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users              User[]
  inventoryMovements InventoryMovement[]
  inventoryBalances  InventoryBalance[]
}

enum ProductCategory {
  LANCHE
  BEBIDA
  SOBREMESA
  ACOMPANHAMENTO
  COMBO
}

model Product {
  id          Int             @id @default(autoincrement())
  sku         String          @unique // codigo de da rede (ex.: "LAN-001")
  name        String
  description String?
  category    ProductCategory
  price       Decimal         @db.Decimal(10, 2)
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  inventoryMovements InventoryMovement[]
  inventoryBalances  InventoryBalance[]

  @@index([category, active])
}

model InventoryMovement {
  id        Int                   @id @default(autoincrement())
  type      InventoryMovementType
  quantity  Int
  reason    String?
  branchId  Int
  productId Int
  userId    Int? 
  createdAt DateTime              @default(now())

  branch  Branch  @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@index([branchId, productId])
}


model InventoryBalance {
  branchId  Int
  productId Int
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt

  branch  Branch  @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@id([branchId, productId])
}
