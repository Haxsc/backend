generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PerfilUsuario {
  ADMIN
  GERENTE
  ATENDENTE
  COZINHA
  CLIENTE
}

enum CanalPedido {
  APP
  TOTEM
  BALCAO
  PICKUP
  WEB
}

enum StatusPedido {
  AGUARDANDO_PAGAMENTO
  PAGO
  EM_PREPARO
  PRONTO
  CONCLUIDO
  CANCELADO
}

enum StatusPagamento {
  PENDENTE
  APROVADO
  RECUSADO
  ESTORNADO
}

enum FormaPagamento {
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  DINHEIRO
  MOCK
}

enum TipoMovimentacao {
  ENTRADA
  SAIDA
  AJUSTE
}

enum CategoriaProduto {
  LANCHE
  BEBIDA
  SOBREMESA
  ACOMPANHAMENTO
  COMBO
}

model Usuario {
  id                        Int           @id @default(autoincrement())
  nome                      String
  email                     String        @unique
  senhaHash                 String
  perfil                    PerfilUsuario @default(CLIENTE)
  ativo                     Boolean       @default(true)
  termosAceitosEm           DateTime? // aceite contratual dos termos de uso
  consentimentoFidelidadeEm DateTime? // programa de fidelidade
  criadoEm                  DateTime      @default(now())
  atualizadoEm              DateTime      @updatedAt

  unidadeId Int?
  unidade   Unidade? @relation(fields: [unidadeId], references: [id])

  movimentacoesEstoque MovimentacaoEstoque[]
  pedidos              Pedido[]
  logsAuditoria        LogAuditoria[]
}

model Unidade {
  id           Int      @id @default(autoincrement())
  codigo       String   @unique // codigo operacional da loja (ex.: "SP-001")
  nome         String
  ehMatriz     Boolean  @default(false) // matriz da rede
  cidade       String
  estado       String   @db.Char(2)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuarios             Usuario[]
  movimentacoesEstoque MovimentacaoEstoque[]
  saldosEstoque        SaldoEstoque[]
  pedidos              Pedido[]
}

model Produto {
  id           Int              @id @default(autoincrement())
  sku          String           @unique // codigo de catalogo da rede (ex.: "LAN-001")
  nome         String
  descricao    String?
  categoria    CategoriaProduto
  preco        Decimal          @db.Decimal(10, 2)
  ativo        Boolean          @default(true)
  criadoEm     DateTime         @default(now())
  atualizadoEm DateTime         @updatedAt

  movimentacoesEstoque MovimentacaoEstoque[]
  saldosEstoque        SaldoEstoque[]
  itensPedido          ItemPedido[]

  @@index([categoria, ativo])
}

model MovimentacaoEstoque {
  id         Int              @id @default(autoincrement())
  tipo       TipoMovimentacao
  quantidade Int
  motivo     String?
  unidadeId  Int
  produtoId  Int
  usuarioId  Int? // nulo quando a baixa e automatica (venda)
  criadoEm   DateTime         @default(now())

  unidade Unidade  @relation(fields: [unidadeId], references: [id])
  produto Produto  @relation(fields: [produtoId], references: [id])
  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([unidadeId, produtoId])
}

model SaldoEstoque {
  unidadeId    Int
  produtoId    Int
  quantidade   Int      @default(0)
  atualizadoEm DateTime @updatedAt

  unidade Unidade @relation(fields: [unidadeId], references: [id])
  produto Produto @relation(fields: [produtoId], references: [id])

  @@id([unidadeId, produtoId])
}

model Pedido {
  id           Int          @id @default(autoincrement())
  unidadeId    Int
  clienteId    Int?
  canalPedido  CanalPedido
  status       StatusPedido @default(AGUARDANDO_PAGAMENTO)
  total        Decimal      @db.Decimal(10, 2)
  observacoes  String?
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt

  unidade Unidade  @relation(fields: [unidadeId], references: [id])
  cliente Usuario? @relation(fields: [clienteId], references: [id])

  itens      ItemPedido[]
  pagamentos Pagamento[]

  @@index([canalPedido])
  @@index([status])
  @@index([unidadeId, criadoEm])
}

model ItemPedido {
  id            Int     @id @default(autoincrement())
  pedidoId      Int
  produtoId     Int
  quantidade    Int
  precoUnitario Decimal @db.Decimal(10, 2)

  pedido  Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id])

  @@unique([pedidoId, produtoId])
}

model Pagamento {
  id                Int             @id @default(autoincrement())
  pedidoId          Int
  forma             FormaPagamento
  status            StatusPagamento @default(PENDENTE)
  valor             Decimal         @db.Decimal(10, 2)
  transacaoId       String?         @unique // id devolvido pelo gateway simulado
  chaveIdempotencia String?         @unique // evita cobranca duplicada
  payloadRetorno    Json? // resposta bruta do gateway
  mensagemErro      String? // motivo da recusa, quando houver
  processadoEm      DateTime?
  criadoEm          DateTime        @default(now())
  atualizadoEm      DateTime        @updatedAt

  pedido Pedido @relation(fields: [pedidoId], references: [id])

  @@index([pedidoId, status])
}

model LogAuditoria {
  id        Int            @id @default(autoincrement())
  acao      String
  recurso   String
  recursoId String?
  usuarioId Int?
  perfil    PerfilUsuario?
  ip        String?
  detalhes  Json?
  criadoEm  DateTime       @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([recurso, recursoId])
  @@index([usuarioId, criadoEm])
}
